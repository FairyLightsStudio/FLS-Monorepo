"""FlightStudio root package.

Every project directory provides an `fls_project(name = "workspace")` marker
(see tools/bazel/fls_project.bzl); fls uses `bazel query deps(//Project/...)`
to compute the coarse cross-project dependency closure.

This root package also exposes a workspace marker that depends on the projects
with real buildable content. TeraPanel intentionally has no rust_* Bazel
targets (see MODULE.bazel docstring and TeraPanel/BUILD.bazel).
"""

load("//tools/bazel:fls_project.bzl", "fls_project")

package(default_visibility = ["//visibility:public"])

fls_project(
    name = "workspace",
    deps = [
        "//ChatHistoryCat:workspace",
        "//LiLi_converter:workspace",
        "//PoWCAPTCHA:workspace",
        "//TeraPanel:workspace",
        "//UserCenter:workspace",
    ],
)
