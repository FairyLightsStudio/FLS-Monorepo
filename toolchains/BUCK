load(":zig_direct.bzl", "cxx_zig_direct_toolchain")

# FLS uses the Zig-based self-contained C/C++ toolchain instead of the system
# clang. The system `path_clang_tools` toolchain hands out bare compiler names
# (e.g. `clang`) which buck2's `from_any_dir.py` fails to resolve via
# `os.execl` (execv does no PATH lookup), breaking the C build scripts of
# native Rust dependencies (ring, aws-lc-rs, zstd-sys) and hanging
# `rust-project develop-json` project discovery.
#
# Unlike prelude's `cxx_zig_toolchain` (which wraps `zig cc` in a
# `cmd_script` shell wrapper that resolves the zig binary via a relative path
# and therefore breaks when invoked from a build script's arbitrary cwd), the
# `cxx_zig_direct_toolchain` exposes `zig cc`/`zig c++`/`zig ar` directly as
# `RunInfo` arguments, so the compiler is a real executable reachable from any
# working directory. See toolchains/zig_direct.bzl.
download_zig_distribution(
    name = "zig",
    version = "0.14.0",
)

# connectrpc-build invokes protoc and needs the canonical well-known .proto
# sources when compiling Google API annotations. Keep this archive aligned with
# Prelude's protoc 3.25.6 executable.
http_archive(
    name = "protobuf-source",
    sha256 = "ecfeb9f673e63321b4871c1cee6b5adeb0ef711d08a0c5bb1945271767df65bf",
    strip_prefix = "protobuf-25.6",
    urls = ["https://github.com/protocolbuffers/protobuf/releases/download/v25.6/protobuf-25.6.tar.gz"],
    visibility = ["PUBLIC"],
)

cxx_zig_direct_toolchain(
    name = "cxx",
    distribution = ":zig",
    visibility = ["PUBLIC"],
)

# The Prelude's C/C++ toolchain attribute has a deliberately unreachable
# select() branch that points at this label. Unconfigured graph queries still
# traverse every branch, so the label must exist even though configured builds
# resolve to :cxx. The zig toolchain does not define default dependencies,
# therefore forwarding to :cxx preserves the intended semantics.
toolchain_alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

system_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    # FLS uses the stable Rust channel. Keep this explicit because the Prelude
    # default has changed between Buck2 releases.
    nightly_features = False,
    rustc_flags = [
        "-Copt-level=0",
        "-Cdebuginfo=2",
    ],
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)
