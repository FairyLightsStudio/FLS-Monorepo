        <mxCell id="rEsHFhmzaF56JFFrAZQ2-33" value="&lt;ul style=&quot;font-size: 16px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;要求服务单在发往该服务单位之前必须经过其他服务窗口（&lt;/font&gt;Wants=、&lt;code data-immersive-translate-walked=&quot;c584419f-4423-47a1-8dce-941df4f95aa4&quot; class=&quot;varname&quot;&gt;Requires=）&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=25;align=left;verticalAlign=top;" parent="1" vertex="1">
