{
  "name": "storybook",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "storybook/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "storybook/.storybook",
        "browserTarget": "storybook:build-storybook",
        "compodoc": false,
        "compodocArgs": [
          "-d",
          "storybook",
          "--disableLifeCycleHooks",
          "--disableProtected",
          "--disableInternal",
          "--disablePrivate"
        ],
        "styles": [
          "storybook/src/material-theme.scss",
          "storybook/src/styles.sass",
          "components/button/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["node_modules"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        },
        "development": {
          "sourceMap": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/storybook",
        "configDir": "storybook/.storybook",
        "browserTarget": "storybook:build-storybook",
        "compodoc": false,
        "compodocArgs": [
          "-d",
          "storybook",
          "--disableLifeCycleHooks",
          "--disableProtected",
          "--disableInternal",
          "--disablePrivate"
        ],
        "styles": [
          "storybook/src/material-theme.scss",
          "storybook/src/styles.sass",
          "components/button/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["node_modules"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c storybook/.storybook --url=http://localhost:4400"
      }
    },
    "static-storybook": {
      "executor": "@nx/web:file-server",
      "dependsOn": ["build-storybook"],
      "options": {
        "buildTarget": "storybook:build-storybook",
        "staticFilePath": "dist/storybook/storybook",
        "spa": true
      },
      "configurations": {
        "ci": {
          "buildTarget": "storybook:build-storybook:ci"
        }
      }
    }
  }
}
