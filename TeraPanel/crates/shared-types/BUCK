load("@prelude//rust:cargo_buildscript.bzl", "buildscript_run")

filegroup(
    name = "connectrpc-manifest",
    srcs = {
        "build.rs": "build.rs",
    },
)

rust_binary(
    name = "connectrpc-build-script",
    srcs = ["build.rs"],
    crate = "build_script_build",
    crate_root = "build.rs",
    edition = "2024",
    deps = ["root//third-party/rust:connectrpc-build"],
)

buildscript_run(
    name = "connectrpc-codegen",
    package_name = "shared-types",
    version = "0.1.0",
    buildscript_rule = ":connectrpc-build-script",
    manifest_dir = ":connectrpc-manifest",
    env = {
        "PROTOBUF_INCLUDE_DIR": "$(location toolchains//:protobuf-source)/src",
        "PROTOC": "$(exe prelude//toolchains/android/tools/protobuf:protoc)",
        "TERAPANEL_IDL_DIR": "$(location root//TeraPanel:connectrpc-idl)",
    },
)

rust_library(
    name = "shared-types",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    env = {
        "OUT_DIR": "$(location :connectrpc-codegen[out_dir])",
    },
    visibility = ["PUBLIC"],
    deps = [
        "root//third-party/rust:buffa",
        "root//third-party/rust:buffa-types",
        "root//third-party/rust:connectrpc",
        "root//third-party/rust:serde",
        "root//third-party/rust:serde_json",
    ],
)
