load("//build_defs:fls_project.bzl", "fls_project")

filegroup(
    name = "connectrpc-idl",
    srcs = {
        path.removeprefix("idl/"): path
        for path in glob(["idl/**/*.proto"])
    },
    visibility = ["PUBLIC"],
)

fls_project(
    name = "workspace",
    deps = ["root//UserCenter:workspace"],
    visibility = ["PUBLIC"],
)
